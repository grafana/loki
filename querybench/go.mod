// The tool lives inside the Loki repo and builds against the in-tree LogQL
// parser. Building against loki/v3 as a library requires mirroring Loki's own
// replace directives, because Go does not apply a dependency's replaces. When
// the tool moves to its own repository, replace loki/v3 with a pinned release
// and keep these mirrored replaces in sync with that release's go.mod.
replace (
	github.com/Azure/azure-sdk-for-go => github.com/Azure/azure-sdk-for-go v68.0.0+incompatible
	github.com/Azure/azure-storage-blob-go => github.com/MasslessParticle/azure-storage-blob-go v0.14.1-0.20240322194317-344980fda573
	github.com/gocql/gocql => github.com/grafana/gocql v0.0.0-20200605141915-ba5dc39ece85
	github.com/grafana/loki/pkg/push => ../pkg/push
	github.com/grafana/loki/v3 => ..
	github.com/grafana/regexp => github.com/grafana/regexp v0.0.0-20250905093917-f7b3be9d1853
	github.com/hashicorp/memberlist => github.com/grafana/memberlist v0.3.1-0.20260515134459-1798cf41aca7
	github.com/influxdata/go-syslog/v3 => github.com/leodido/go-syslog/v4 v4.6.0
	github.com/thanos-io/objstore => github.com/grafana/objstore v0.0.0-20260721130030-becd33cc63ff
)
