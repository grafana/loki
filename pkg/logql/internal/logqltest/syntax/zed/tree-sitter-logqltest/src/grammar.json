{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "logqltest",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\n"
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "clear_command"
        },
        {
          "type": "SYMBOL",
          "name": "load_command"
        },
        {
          "type": "SYMBOL",
          "name": "eval_instant"
        },
        {
          "type": "SYMBOL",
          "name": "eval_range"
        },
        {
          "type": "SYMBOL",
          "name": "eval_select"
        },
        {
          "type": "SYMBOL",
          "name": "expect_command"
        },
        {
          "type": "SYMBOL",
          "name": "skip_command"
        },
        {
          "type": "SYMBOL",
          "name": "stream_line"
        },
        {
          "type": "SYMBOL",
          "name": "scalar_line"
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    },
    "clear_command": {
      "type": "STRING",
      "value": "clear"
    },
    "load_command": {
      "type": "STRING",
      "value": "load"
    },
    "eval_instant": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "eval"
        },
        {
          "type": "STRING",
          "value": "instant"
        },
        {
          "type": "STRING",
          "value": "at"
        },
        {
          "type": "SYMBOL",
          "name": "_time"
        },
        {
          "type": "SYMBOL",
          "name": "_query"
        }
      ]
    },
    "eval_range": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "eval"
        },
        {
          "type": "STRING",
          "value": "range"
        },
        {
          "type": "STRING",
          "value": "from"
        },
        {
          "type": "SYMBOL",
          "name": "_time"
        },
        {
          "type": "STRING",
          "value": "to"
        },
        {
          "type": "SYMBOL",
          "name": "_time"
        },
        {
          "type": "STRING",
          "value": "step"
        },
        {
          "type": "SYMBOL",
          "name": "_time"
        },
        {
          "type": "SYMBOL",
          "name": "_query"
        }
      ]
    },
    "eval_select": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "eval"
        },
        {
          "type": "STRING",
          "value": "select"
        },
        {
          "type": "STRING",
          "value": "from"
        },
        {
          "type": "SYMBOL",
          "name": "_time"
        },
        {
          "type": "STRING",
          "value": "to"
        },
        {
          "type": "SYMBOL",
          "name": "_time"
        },
        {
          "type": "SYMBOL",
          "name": "direction"
        },
        {
          "type": "SYMBOL",
          "name": "_query"
        }
      ]
    },
    "direction": {
      "type": "PATTERN",
      "value": "[Ff][Oo][Rr][Ww][Aa][Rr][Dd]|[Bb][Aa][Cc][Kk][Ww][Aa][Rr][Dd]"
    },
    "_time": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_word"
      },
      "named": true,
      "value": "duration"
    },
    "_word": {
      "type": "PATTERN",
      "value": "[^\\s#]+"
    },
    "_text": {
      "type": "PATTERN",
      "value": "(?:[^\\s#\"`]|\"[^\"\\n]*\"|`[^`\\n]*`)(?:[ \\t\\r]*(?:[^\\s#\"`]|\"[^\"\\n]*\"|`[^`\\n]*`))*"
    },
    "_query": {
      "type": "FIELD",
      "name": "query",
      "content": {
        "type": "ALIAS",
        "content": {
          "type": "SYMBOL",
          "name": "_text"
        },
        "named": true,
        "value": "query"
      }
    },
    "expect_command": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "expect"
            },
            {
              "type": "STRING",
              "value": "empty"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "expect"
            },
            {
              "type": "STRING",
              "value": "ordered"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "expect"
            },
            {
              "type": "STRING",
              "value": "fail"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "CHOICE",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "msg:"
                        },
                        {
                          "type": "STRING",
                          "value": "regex:"
                        }
                      ]
                    },
                    {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "_text"
                      },
                      "named": true,
                      "value": "failure_text"
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "expect"
            },
            {
              "type": "STRING",
              "value": "values-toleration"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_word"
              },
              "named": true,
              "value": "number"
            },
            {
              "type": "STRING",
              "value": "on"
            },
            {
              "type": "SYMBOL",
              "name": "stack_name"
            }
          ]
        }
      ]
    },
    "skip_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "skip"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_word"
          },
          "named": true,
          "value": "skip_target"
        },
        {
          "type": "STRING",
          "value": "on"
        },
        {
          "type": "SYMBOL",
          "name": "stack_name"
        }
      ]
    },
    "stack_name": {
      "type": "PATTERN",
      "value": "\"[^\"\\n]*\""
    },
    "stream_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "label_set"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "REPEAT1",
              "content": {
                "type": "SYMBOL",
                "name": "_sample"
              }
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_log_line"
                },
                {
                  "type": "SYMBOL",
                  "name": "at_clause"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_clause"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "label_set": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label_set_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "}"
          }
        }
      ]
    },
    "label_set_body": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^}\\n]+"
      }
    },
    "_log_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "raw_string"
        }
      ]
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "template_variable"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_string_text"
                },
                "named": true,
                "value": "string_content"
              }
            ]
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "\""
          }
        }
      ]
    },
    "raw_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "`"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "template_variable"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_raw_text"
                },
                "named": true,
                "value": "string_content"
              }
            ]
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "`"
          }
        }
      ]
    },
    "_string_text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "[^\"{\\n]+"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PREC",
            "value": -1,
            "content": {
              "type": "STRING",
              "value": "{"
            }
          }
        }
      ]
    },
    "_raw_text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "[^`{\\n]+"
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PREC",
            "value": -1,
            "content": {
              "type": "STRING",
              "value": "{"
            }
          }
        }
      ]
    },
    "template_variable": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\{\\{[ \\t]*\\.[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\}\\}"
      }
    },
    "at_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_word"
          },
          "named": true,
          "value": "duration"
        }
      ]
    },
    "_clause": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "repeat_clause"
        },
        {
          "type": "SYMBOL",
          "name": "metadata_clause"
        },
        {
          "type": "SYMBOL",
          "name": "parsed_clause"
        }
      ]
    },
    "repeat_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "repeat"
        },
        {
          "type": "STRING",
          "value": "every"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_clause_word"
          },
          "named": true,
          "value": "duration"
        },
        {
          "type": "STRING",
          "value": "for"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_clause_word"
          },
          "named": true,
          "value": "number"
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "_clause_word": {
      "type": "PATTERN",
      "value": "[^\\s\\]#]+"
    },
    "metadata_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "metadata"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "label_pair"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "parsed_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "parsed"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "label_pair"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "label_pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "label_name"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "SYMBOL",
          "name": "label_value"
        }
      ]
    },
    "label_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\s\"=\\]#]+"
        },
        {
          "type": "PATTERN",
          "value": "\"[^\"\\n]*\""
        }
      ]
    },
    "label_value": {
      "type": "PATTERN",
      "value": "\"[^\"\\n]*\""
    },
    "scalar_line": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_sample"
      }
    },
    "_sample": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "gap"
        },
        {
          "type": "SYMBOL",
          "name": "special_float"
        },
        {
          "type": "SYMBOL",
          "name": "expansion"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "gap": {
      "type": "STRING",
      "value": "_"
    },
    "special_float": {
      "type": "PATTERN",
      "value": "NaN|[+-]?Inf"
    },
    "number": {
      "type": "PATTERN",
      "value": "[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"
    },
    "expansion": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 1,
                  "content": {
                    "type": "PATTERN",
                    "value": "[+-][0-9]+(?:\\.[0-9]+)?"
                  }
                }
              },
              "named": true,
              "value": "number"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "STRING",
              "value": "x"
            }
          },
          "named": true,
          "value": "expansion_operator"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "[0-9]+"
            }
          },
          "named": true,
          "value": "number"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}