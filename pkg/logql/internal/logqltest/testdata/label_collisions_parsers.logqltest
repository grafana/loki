  {app="regexp_20a", foo_extracted="le"} "p|lit|b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="regexp_21a", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
