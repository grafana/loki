  {app="regexp_33a", foo="l", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
eval select from 0 to 30s forward {app=~"regexp_..a"} | regexp `(?P<foo>\w+)\|(?P<foo_extracted>\w+)\|(?P<bar>\w+)` | foo_extracted="lit"
  {app="regexp_00a"} "p|lit|b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="regexp_01a"} "p|lit|b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="regexp_10a", foo="l"} "p|lit|b" @ 10s [parsed bar="b" foo_extracted="lit"]
eval select from 0 to 30s forward {app=~"regexp_..a"} | regexp `(?P<foo>\w+)\|(?P<foo_extracted>\w+)\|(?P<bar>\w+)` | foo_extracted="m"
  {app="regexp_11a", foo="l"} "p|lit|b" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
eval select from 0 to 30s forward {app=~"regexp_..a"} | regexp `(?P<foo>\w+)\|(?P<foo_extracted>\w+)\|(?P<bar>\w+)` | foo_extracted="me"
  {app="regexp_02a"} "p|lit|b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="regexp_03a"} "p|lit|b" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
