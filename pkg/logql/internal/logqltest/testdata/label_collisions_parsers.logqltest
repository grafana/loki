eval select from 0 to 30s forward {app=~"regexp_..b"} | regexp `(?P<foo_extracted>\w+)\|(?P<foo>\w+)\|(?P<bar>\w+)` | line_format "{{.foo}}|{{.foo_extracted}}"
  {app="regexp_00b"} "p|lit" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
