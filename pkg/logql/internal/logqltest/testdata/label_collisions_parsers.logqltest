  {app="regexp_13a", foo="l"} "p|lit|b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
eval select from 0 to 30s forward {app=~"regexp_..a"} | regexp `(?P<foo>\w+)\|(?P<foo_extracted>\w+)\|(?P<bar>\w+)` | foo="l"
  {app="regexp_10a", foo="l"} "p|lit|b" @ 10s [parsed bar="b" foo_extracted="lit"]
