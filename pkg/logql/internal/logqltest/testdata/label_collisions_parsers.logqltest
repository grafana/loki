  {app="logfmt_30b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmt_31a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmt_31b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
