  {app="regexp_30b", foo="l", foo_extracted="le"} "lit|p|b" @ 10s
  {app="regexp_31a", foo="l", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo="m"]
  {app="regexp_31b", foo="l", foo_extracted="le"} "lit|p|b" @ 10s [metadata foo="m"]
