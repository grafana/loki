  {app="pattern_03b"} "lit p b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="pattern_10a", foo="l"} "p lit b" @ 10s
  {app="pattern_10b", foo="l"} "lit p b" @ 10s
  {app="pattern_11a", foo="l"} "p lit b" @ 10s [metadata foo="m"]
