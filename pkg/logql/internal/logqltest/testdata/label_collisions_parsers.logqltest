eval select from 0 to 30s forward {app=~"logfmt_..[ab]"} | drop foo_extracted | logfmt
  {app="logfmt_00a"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
