eval select from 0 to 30s forward {app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` | foo="l"
  {app="pattern_10a", foo="l"} "p lit b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="pattern_11a", foo="l"} "p lit b" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
