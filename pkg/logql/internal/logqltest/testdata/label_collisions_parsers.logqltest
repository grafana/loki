  {app="pattern_22a", foo_extracted="le"} "p lit b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="pattern_23a", foo_extracted="le"} "p lit b" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="pattern_30a", foo="l", foo_extracted="le"} "p lit b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="pattern_31a", foo="l", foo_extracted="le"} "p lit b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="pattern_32a", foo="l", foo_extracted="le"} "p lit b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="pattern_33a", foo="l", foo_extracted="le"} "p lit b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
# pattern: a label filter after the parser, for every final value of `foo_extracted` and `foo`. Key order a.
eval select from 0 to 30s forward {app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` | foo_extracted="le"
  {app="pattern_20a", foo_extracted="le"} "p lit b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
