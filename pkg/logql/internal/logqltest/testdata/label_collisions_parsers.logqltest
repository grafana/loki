eval select from 0 to 30s forward {app=~"regexp_..b"} | drop foo_extracted | regexp `(?P<foo_extracted>\w+)\|(?P<foo>\w+)\|(?P<bar>\w+)`
  {app="regexp_00b"} "lit|p|b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="regexp_01b"} "lit|p|b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="regexp_02b"} "lit|p|b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="regexp_03b"} "lit|p|b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="regexp_10b", foo="l"} "lit|p|b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="regexp_11b", foo="l"} "lit|p|b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="regexp_12b", foo="l"} "lit|p|b" @ 10s [parsed bar="b" foo_extracted="lit"]
