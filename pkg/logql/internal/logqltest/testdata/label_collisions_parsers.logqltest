# pattern: every set of stream labels x every set of metadata x both key orders. Key order a.
eval select from 0 to 30s forward {app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>`
  {app="pattern_00a"} "p lit b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="pattern_01a"} "p lit b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="pattern_02a"} "p lit b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
