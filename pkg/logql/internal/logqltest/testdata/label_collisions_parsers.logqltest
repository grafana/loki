eval select from 0 to 30s forward {app=~"pattern_..a"} | drop foo_extracted | pattern `<foo> <foo_extracted> <bar>`
  {app="pattern_00a"} "p lit b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
