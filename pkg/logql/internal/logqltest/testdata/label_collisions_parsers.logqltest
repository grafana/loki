  {app="regexp_32b", foo="l", foo_extracted="le"} "lit|p|b" @ 10s [metadata foo_extracted="me"]
  {app="regexp_33a", foo="l", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="regexp_33b", foo="l", foo_extracted="le"} "lit|p|b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="regexp_c_b3", foo="l"} "x" @ 10s # B3
  {app="regexp_c_c2"} "x" @ 10s [metadata foo="m"] # C2
  {app="regexp_c_d2", foo="l"} "x" @ 10s [metadata foo="m"] # D2
