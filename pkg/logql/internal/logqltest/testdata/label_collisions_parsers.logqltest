eval select from 0 to 30s forward {app=~"logfmt_..[ab]"} | logfmt | line_format "{{.foo}}|{{.foo_extracted}}"
  {app="logfmt_00a"} "p|lit" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="logfmt_00b"} "p|lit" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="logfmt_01a"} "m|lit" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="logfmt_01b"} "m|lit" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="logfmt_02a"} "p|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
