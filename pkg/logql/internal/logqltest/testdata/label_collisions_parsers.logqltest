  {foo="l", foo_extracted="le"} 4 4
eval instant at 60s sum by (foo_extracted) (count_over_time({app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` [1m]))
  {foo_extracted="lit"} 3
  {foo_extracted="me"} 4
  {foo_extracted="m"} 1
  {foo_extracted="le"} 8
eval range from 40s to 60s step 20s sum by (foo_extracted) (count_over_time({app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` [1m])) # overlapping
  {foo_extracted="lit"} 3 3
  {foo_extracted="me"} 4 4
  {foo_extracted="m"} 1 1
