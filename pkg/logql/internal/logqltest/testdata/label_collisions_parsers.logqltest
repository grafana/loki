# pattern: grouped metric queries. Key order a.
eval instant at 60s sum by (foo, foo_extracted) (count_over_time({app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` [1m]))
  {foo="p", foo_extracted="lit"} 1
  {foo="m", foo_extracted="lit"} 1
  {foo="p", foo_extracted="me"} 1
  {foo="m", foo_extracted="me"} 1
  {foo="l", foo_extracted="lit"} 1
  {foo="l", foo_extracted="m"} 1
  {foo="l", foo_extracted="me"} 2
  {foo="p", foo_extracted="le"} 2
  {foo="m", foo_extracted="le"} 2
  {foo="l", foo_extracted="le"} 4
eval range from 40s to 60s step 20s sum by (foo, foo_extracted) (count_over_time({app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` [1m])) # overlapping
  {foo="p", foo_extracted="lit"} 1 1
  {foo="m", foo_extracted="lit"} 1 1
  {foo="p", foo_extracted="me"} 1 1
  {foo="m", foo_extracted="me"} 1 1
