eval select from 0 to 30s forward {app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` | foo="m"
  {app="pattern_01a"} "p lit b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
