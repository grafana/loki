# logfmt: single cases. A key that the line lacks, an empty value, a null, a duplicate key.
eval select from 0 to 30s forward {app=~"logfmt_c_.*"} | logfmt
  {app="logfmt_c_b3", foo="l"} "other=x" @ 10s [parsed other="x"]
  {app="logfmt_c_c2"} "other=x" @ 10s [metadata foo="m"] [parsed other="x"]
  {app="logfmt_c_d2", foo="l"} "other=x" @ 10s [metadata foo_extracted="m"] [parsed other="x"]
  {app="logfmt_c_d3", foo="l"} "foo=p" @ 10s [metadata foo_extracted="me"]
  {app="logfmt_c_f2"} "foo_extracted=lit" @ 10s [parsed foo_extracted="lit"]
  {app="logfmt_c_f4", foo_extracted="le"} "foo_extracted=p" @ 10s [parsed foo_extracted_extracted="p"]
  {app="logfmt_c_f5"} "foo_extracted=p" @ 10s [metadata foo_extracted="me"] [parsed foo_extracted_extracted="p"]
  {app="logfmt_c_g1", foo="l"} "foo=" @ 10s
  {app="logfmt_c_g2"} "foo=" @ 10s
  {app="logfmt_c_h1"} "foo=a foo=b" @ 10s [parsed foo="a"]
  {app="logfmt_c_h3", foo="l"} "foo=a foo=b" @ 10s [parsed foo_extracted="a"]
  {app="logfmt_c_h4"} "foo=a foo=b" @ 10s [metadata foo="m"] [parsed foo_extracted="a"]
# logfmt: the same single cases with `--keep-empty`.
eval select from 0 to 30s forward {app=~"logfmt_c_.*"} | logfmt --keep-empty
  {app="logfmt_c_b3", foo="l"} "other=x" @ 10s [parsed other="x"]
  {app="logfmt_c_c2"} "other=x" @ 10s [metadata foo="m"] [parsed other="x"]
  {app="logfmt_c_d2", foo="l"} "other=x" @ 10s [metadata foo_extracted="m"] [parsed other="x"]
  {app="logfmt_c_d3", foo="l"} "foo=p" @ 10s [metadata foo_extracted="me"]
  {app="logfmt_c_f2"} "foo_extracted=lit" @ 10s [parsed foo_extracted="lit"]
  {app="logfmt_c_f4", foo_extracted="le"} "foo_extracted=p" @ 10s [parsed foo_extracted_extracted="p"]
  {app="logfmt_c_f5"} "foo_extracted=p" @ 10s [metadata foo_extracted="me"] [parsed foo_extracted_extracted="p"]
  {app="logfmt_c_g1", foo="l"} "foo=" @ 10s [parsed foo_extracted=""]
  {app="logfmt_c_g2"} "foo=" @ 10s [parsed foo=""]
  {app="logfmt_c_h1"} "foo=a foo=b" @ 10s [parsed foo="a"]
  {app="logfmt_c_h3", foo="l"} "foo=a foo=b" @ 10s [parsed foo_extracted="a"]
  {app="logfmt_c_h4"} "foo=a foo=b" @ 10s [metadata foo="m"] [parsed foo_extracted="a"]

# regexp
clear
load
  {app="regexp_00a"} "p|lit|b" @ 10s
  {app="regexp_00b"} "lit|p|b" @ 10s
  {app="regexp_01a"} "p|lit|b" @ 10s [metadata foo="m"]
  {app="regexp_01b"} "lit|p|b" @ 10s [metadata foo="m"]
