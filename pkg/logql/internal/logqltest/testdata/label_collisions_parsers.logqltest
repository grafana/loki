  {app="jsonx_00b"} "p|lit" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="jsonx_01a"} "m|lit" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="jsonx_01b"} "m|lit" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="jsonx_02a"} "p|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="jsonx_02b"} "p|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="jsonx_03a"} "m|me" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_03b"} "m|me" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_10a", foo="l"} "l|lit" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="jsonx_10b", foo="l"} "l|lit" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="jsonx_11a", foo="l"} "l|m" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_11b", foo="l"} "l|m" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_12a", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_12b", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_13a", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_13b", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_20a", foo_extracted="le"} "p|le" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="jsonx_20b", foo_extracted="le"} "p|le" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="jsonx_21a", foo_extracted="le"} "m|le" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_21b", foo_extracted="le"} "m|le" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_22a", foo_extracted="le"} "p|le" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="jsonx_22b", foo_extracted="le"} "p|le" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="jsonx_23a", foo_extracted="le"} "m|le" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="jsonx_23b", foo_extracted="le"} "m|le" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="jsonx_30a", foo="l", foo_extracted="le"} "l|le" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_30b", foo="l", foo_extracted="le"} "l|le" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_31a", foo="l", foo_extracted="le"} "l|le" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_31b", foo="l", foo_extracted="le"} "l|le" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="jsonx_32a", foo="l", foo_extracted="le"} "l|le" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="jsonx_32b", foo="l", foo_extracted="le"} "l|le" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="jsonx_33a", foo="l", foo_extracted="le"} "l|le" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="jsonx_33b", foo="l", foo_extracted="le"} "l|le" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]

# jsonx: single cases. A key that the line lacks, an empty value, a null, a duplicate key.
eval select from 0 to 30s forward {app=~"jsonx_c_.*"} | json foo, foo_extracted, bar, other
  {app="jsonx_c_b3", foo="l"} `{"other":"x"}` @ 10s [parsed bar="" foo_extracted="" other="x"]
  {app="jsonx_c_c2"} `{"other":"x"}` @ 10s [metadata foo="m"] [parsed bar="" foo_extracted="" other="x"]
  {app="jsonx_c_d2", foo="l"} `{"other":"x"}` @ 10s [metadata foo_extracted="m"] [parsed bar="" other="x"]
  {app="jsonx_c_d3", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="me"] [parsed bar="" other=""]
  {app="jsonx_c_f2"} `{"foo_extracted":"lit"}` @ 10s [parsed bar="" foo="" foo_extracted="lit" other=""]
  {app="jsonx_c_f4", foo_extracted="le"} `{"foo_extracted":"p"}` @ 10s [parsed bar="" foo="" foo_extracted_extracted="p" other=""]
  {app="jsonx_c_f5"} `{"foo_extracted":"p"}` @ 10s [metadata foo_extracted="me"] [parsed bar="" foo="" foo_extracted_extracted="p" other=""]
  {app="jsonx_c_g1", foo="l"} `{"foo":""}` @ 10s [parsed bar="" foo_extracted="" other=""]
  {app="jsonx_c_g2"} `{"foo":""}` @ 10s [parsed bar="" foo="" foo_extracted="" other=""]
  {app="jsonx_c_g3", foo="l"} `{"foo":null}` @ 10s [parsed bar="" foo_extracted="" other=""]
  {app="jsonx_c_g3b"} `{"foo":null}` @ 10s [parsed bar="" foo="" foo_extracted="" other=""]
  {app="jsonx_c_h1"} `{"foo":"a","foo":"b"}` @ 10s [parsed bar="" foo="a" foo_extracted="" other=""]
  {app="jsonx_c_h3", foo="l"} `{"foo":"a","foo":"b"}` @ 10s [parsed bar="" foo_extracted="a" other=""]
  {app="jsonx_c_h4"} `{"foo":"a","foo":"b"}` @ 10s [metadata foo="m"] [parsed bar="" foo_extracted="a" other=""]

# logfmtx
clear
load
  {app="logfmtx_00a"} "foo=p foo_extracted=lit bar=b" @ 10s
  {app="logfmtx_00b"} "foo_extracted=lit foo=p bar=b" @ 10s
  {app="logfmtx_01a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_01b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_02a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_02b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_03a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_03b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_10a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s
  {app="logfmtx_10b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s
  {app="logfmtx_11a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_11b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_12a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_12b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_13a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_13b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_20a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s
  {app="logfmtx_20b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s
  {app="logfmtx_21a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_21b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_22a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_22b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_23a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_23b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_30a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s
  {app="logfmtx_30b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s
  {app="logfmtx_31a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_31b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"]
  {app="logfmtx_32a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_32b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"]
  {app="logfmtx_33a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_33b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted="me"]
  {app="logfmtx_c_b3", foo="l"} "other=x" @ 10s # B3
  {app="logfmtx_c_c2"} "other=x" @ 10s [metadata foo="m"] # C2
  {app="logfmtx_c_d2", foo="l"} "other=x" @ 10s [metadata foo="m"] # D2
  {app="logfmtx_c_d3", foo="l"} "foo=p" @ 10s [metadata foo_extracted="me"] # D3
  {app="logfmtx_c_f2"} "foo_extracted=lit" @ 10s # F2
  {app="logfmtx_c_f4", foo_extracted="le"} "foo_extracted=p" @ 10s # F4
  {app="logfmtx_c_f5"} "foo_extracted=p" @ 10s [metadata foo_extracted="me"] # F5
  {app="logfmtx_c_g1", foo="l"} "foo=" @ 10s # G1
  {app="logfmtx_c_g2"} "foo=" @ 10s # G2
  {app="logfmtx_c_h1"} "foo=a foo=b" @ 10s # H1
  {app="logfmtx_c_h3", foo="l"} "foo=a foo=b" @ 10s # H3
  {app="logfmtx_c_h4"} "foo=a foo=b" @ 10s [metadata foo="m"] # H4

# logfmtx: every set of stream labels x every set of metadata x both key orders.
eval select from 0 to 30s forward {app=~"logfmtx_..[ab]"} | logfmt foo, foo_extracted, bar
  {app="logfmtx_00a"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="logfmtx_00b"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="logfmtx_01a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_01b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_02a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_02b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_03a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_03b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_10a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_10b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_11a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_11b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_12a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_12b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_13a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_13b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_20a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_20b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_21a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_21b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_22a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="logfmtx_22b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="logfmtx_23a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_23b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_30a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_30b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_31a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_31b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_32a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_32b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_33a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_33b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
# logfmtx: a label filter after the parser, for every final value of `foo_extracted` and `foo`.
eval select from 0 to 30s forward {app=~"logfmtx_..[ab]"} | logfmt foo, foo_extracted, bar | foo_extracted="le"
  {app="logfmtx_20a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_20b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_21a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_21b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_22a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="logfmtx_22b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="logfmtx_23a", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_23b", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_30a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_30b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_31a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_31b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_32a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_32b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_33a", foo="l", foo_extracted="le"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
  {app="logfmtx_33b", foo="l", foo_extracted="le"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b"]
eval select from 0 to 30s forward {app=~"logfmtx_..[ab]"} | logfmt foo, foo_extracted, bar | foo_extracted="lit"
  {app="logfmtx_00a"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="logfmtx_00b"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="logfmtx_01a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_01b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_10a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="logfmtx_10b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
eval select from 0 to 30s forward {app=~"logfmtx_..[ab]"} | logfmt foo, foo_extracted, bar | foo_extracted="m"
  {app="logfmtx_11a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_11b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="m"] [parsed bar="b" foo_extracted_extracted="lit"]
eval select from 0 to 30s forward {app=~"logfmtx_..[ab]"} | logfmt foo, foo_extracted, bar | foo_extracted="me"
  {app="logfmtx_02a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_02b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo="p" foo_extracted_extracted="lit"]
  {app="logfmtx_03a"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_03b"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo="m" foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_12a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_12b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_13a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmtx_13b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
eval select from 0 to 30s forward {app=~"logfmtx_..[ab]"} | logfmt foo, foo_extracted, bar | foo="l"
  {app="logfmtx_10a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
