eval select from 0 to 30s forward {app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` | foo_extracted="lit"
  {app="pattern_00a"} "p lit b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="pattern_01a"} "p lit b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
  {app="pattern_10a", foo="l"} "p lit b" @ 10s [parsed bar="b" foo_extracted="lit"]
eval select from 0 to 30s forward {app=~"pattern_..a"} | pattern `<foo> <foo_extracted> <bar>` | foo_extracted="m"
