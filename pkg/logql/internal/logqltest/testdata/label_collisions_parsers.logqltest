  {app="regexp_21a", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="regexp_22a", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo_extracted_extracted="me"] [parsed bar="b" foo="p"]
  {app="regexp_23a", foo_extracted="le"} "p|lit|b" @ 10s [metadata foo="m" foo_extracted_extracted="me"] [parsed bar="b"]
  {app="regexp_30a", foo="l", foo_extracted="le"} "p|lit|b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
  {app="regexp_31a", foo="l", foo_extracted="le"} "p|lit|b" @ 10s [parsed bar="b" foo_extracted_extracted="lit"]
