# regexp: single cases. A key that the line lacks, an empty value, a null, a duplicate key.
eval select from 0 to 30s forward {app="regexp_c_b3"} | regexp `(?P<other>\w+)`
  {app="regexp_c_b3", foo="l"} "x" @ 10s [parsed other="x"]
eval select from 0 to 30s forward {app="regexp_c_c2"} | regexp `(?P<other>\w+)`
  {app="regexp_c_c2"} "x" @ 10s [metadata foo="m"] [parsed other="x"]
eval select from 0 to 30s forward {app="regexp_c_d2"} | regexp `(?P<other>\w+)`
  {app="regexp_c_d2", foo="l"} "x" @ 10s [metadata foo_extracted="m"] [parsed other="x"]
eval select from 0 to 30s forward {app="regexp_c_d3"} | regexp `(?P<foo>\w+)`
  {app="regexp_c_d3", foo="l"} "p" @ 10s [metadata foo_extracted="me"]
eval select from 0 to 30s forward {app="regexp_c_f2"} | regexp `(?P<foo_extracted>\w+)`
  {app="regexp_c_f2"} "lit" @ 10s [parsed foo_extracted="lit"]
eval select from 0 to 30s forward {app="regexp_c_f4"} | regexp `(?P<foo_extracted>\w+)`
  {app="regexp_c_f4", foo_extracted="le"} "p" @ 10s [parsed foo_extracted_extracted="p"]
eval select from 0 to 30s forward {app="regexp_c_f5"} | regexp `(?P<foo_extracted>\w+)`
  {app="regexp_c_f5"} "p" @ 10s [metadata foo_extracted="me"] [parsed foo_extracted_extracted="p"]

# pattern
clear
load
  {app="pattern_00a"} "p lit b" @ 10s
  {app="pattern_00b"} "lit p b" @ 10s
  {app="pattern_01a"} "p lit b" @ 10s [metadata foo="m"]
  {app="pattern_01b"} "lit p b" @ 10s [metadata foo="m"]
  {app="pattern_02a"} "p lit b" @ 10s [metadata foo_extracted="me"]
