  {app="logfmt_12b", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmt_13a", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
  {app="logfmt_13b", foo="l"} "l|me" @ 10s [metadata foo_extracted="me"] [parsed bar="b" foo_extracted_extracted="lit"]
