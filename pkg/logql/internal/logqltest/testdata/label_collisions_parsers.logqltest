  {app="regexp_c_f5"} "p" @ 10s [metadata foo_extracted="me"] # F5

# regexp: every set of stream labels x every set of metadata x both key orders. Key order a.
eval select from 0 to 30s forward {app=~"regexp_..a"} | regexp `(?P<foo>\w+)\|(?P<foo_extracted>\w+)\|(?P<bar>\w+)`
  {app="regexp_00a"} "p|lit|b" @ 10s [parsed bar="b" foo="p" foo_extracted="lit"]
  {app="regexp_01a"} "p|lit|b" @ 10s [metadata foo="m"] [parsed bar="b" foo_extracted="lit"]
