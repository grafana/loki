#
# Label collisions: what happens when a name comes from more than one of the stream labels, the
# structured metadata, and the parsed fields. This file has one group of cases for each kind of
# collision. A comment on a `load` line says what the stream has. A comment above an `eval` says
# what the query shows.
#

# The stream label, the structured metadata, and the parsed field all have the name `foo`. The
# metadata key moves to `foo_extracted` when it enters the pipeline. The parsed `foo` would move to
# `foo_extracted` too, but it finds the name taken, so the parsed value is dropped. A parsed value
# never replaces a label. A `drop` before the parser frees a name, and naming the label in the
# parser avoids the clash. A `drop` after the parser is too late.
clear
load
  {app="d1", foo="l"}    `{"foo":"p","other":"x"}` @ 10s [metadata foo="m1"]           # the three-way clash
  {app="d2", foo="l"}    `{"other":"x"}`           @ 10s [metadata foo="m"]            # the clash, and the line has no `foo`
  {app="d3", foo="l"}    `{"foo":"p"}`             @ 10s [metadata foo_extracted="me"] # the metadata key is `foo_extracted` already
  {app="d4"}             `{"foo":"p","other":"x"}` @ 10s [metadata foo="m"]            # no stream label
  {app="d5", foo="l"}    `{"foo":"p"}`             @ 10s [metadata foo="m"]            # the three-way clash, for the evals on `drop`
  {app="noise", foo="l"} `{"foo":"noise"}`         @ 10s [metadata foo="m"]

# The parsed value is lost where all three sources have `foo`. The metadata value stays as
# `foo_extracted`. It also stays when the line has no `foo`, and when its key is `foo_extracted`
# already. Without the stream label, the metadata keeps `foo`, and the parsed `foo` moves to
# `foo_extracted`.
eval select from 0 to 30s forward {app=~"d[1-4]"} | json
  {app="d1", foo="l"} `{"foo":"p","other":"x"}` @ 10s [metadata foo_extracted="m1"] [parsed other="x"]
  {app="d2", foo="l"} `{"other":"x"}` @ 10s [metadata foo_extracted="m"] [parsed other="x"]
  {app="d3", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="me"]
  {app="d4"} `{"foo":"p","other":"x"}` @ 10s [metadata foo="m"] [parsed foo_extracted="p" other="x"]
# A metric query merges the categories into one label set. It loses the parsed value in the same
# way.
eval instant at 60s count_over_time({app=~"d[1-4]"} | json [1m])
  {app="d1", foo="l", foo_extracted="m1", other="x"} 1
  {app="d2", foo="l", foo_extracted="m", other="x"} 1
  {app="d3", foo="l", foo_extracted="me"} 1
  {app="d4", foo="m", foo_extracted="p", other="x"} 1
# A grouping on both names gives the same labels.
eval instant at 60s sum by (foo, foo_extracted) (count_over_time({app=~"d[1-4]"} | json [1m]))
  {foo="l", foo_extracted="m1"} 1
  {foo="l", foo_extracted="m"} 1
  {foo="l", foo_extracted="me"} 1
  {foo="m", foo_extracted="p"} 1
eval range from 40s to 60s step 20s sum by (foo, foo_extracted) (count_over_time({app=~"d[1-4]"} | json [1m])) # overlapping
  {foo="l", foo_extracted="m1"} 1 1
  {foo="l", foo_extracted="m"} 1 1
  {foo="l", foo_extracted="me"} 1 1
  {foo="m", foo_extracted="p"} 1 1
# The three-way clash gives the parsed value up. The next evals show the ways around it. This one
# has no workaround, so the parsed value is dropped.
eval select from 0 to 30s forward {app="d5"} | json
  {app="d5", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"]
# `drop foo` before the parser frees `foo`, so the parsed value keeps its name.
eval select from 0 to 30s forward {app="d5"} | drop foo | json
  {app="d5"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"] [parsed foo="p"]
# `drop foo_extracted` before the parser frees `foo_extracted`, so the parsed value takes it.
eval select from 0 to 30s forward {app="d5"} | drop foo_extracted | json
  {app="d5", foo="l"} `{"foo":"p"}` @ 10s [parsed foo_extracted="p"]
# Naming the label in the parser avoids the clash: the value goes to `p`.
eval select from 0 to 30s forward {app="d5"} | json p="foo"
  {app="d5", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"] [parsed p="p"]
# A `drop` after the parser is too late: the parser has already dropped the parsed value.
eval select from 0 to 30s forward {app="d5"} | json | drop foo
  {app="d5"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"]

# Two parsers in a row, where the second stage is an expression form. `line_format` swaps the line
# between the two stages. The first stage to write a name keeps it, so the second stage does not
# overwrite `foo=j1`.
clear
load
  {app="e7"}             `{"foo":"j1","next":"foo=f2"}`  @ 10s # the second stage is `logfmt foo`
  {app="e8"}             `{"foo":"j1"}`                  @ 10s # the second stage is `json foo`
  {app="noise", foo="l"} `{"foo":"noise","next":"foo=noise"}` @ 10s

# `logfmt foo` as the second stage does not overwrite the value of the first stage either.
eval select from 0 to 30s forward {app="e7"} | json | line_format "{{.next}}" | logfmt foo
  {app="e7"} "foo=f2" @ 10s [parsed foo="j1" next="foo=f2"]
# `json foo` as the second stage does not overwrite it either.
eval select from 0 to 30s forward {app="e8"} | json | line_format "{\"foo\":\"j2\"}" | json foo
  {app="e8"} `{"foo":"j2"}` @ 10s [parsed foo="j1"]

# A line has the key `foo` and a literal `foo_extracted` key, and the stream has the label `foo`.
# Both keys target `foo_extracted`. The literal key wins, and the key order in the line does not
# matter. JSON does not define a key order.
clear
load
  {app="f1a", foo="l"}   `{"foo":"p","foo_extracted":"lit"}` @ 10s # the renamed key comes first
  {app="f1b", foo="l"}   `{"foo_extracted":"lit","foo":"p"}` @ 10s # the literal key comes first
  {app="noise", foo="l"} `{"foo":"noise"}`                   @ 10s

# The literal key wins when the renamed key comes first.
eval select from 0 to 30s forward {app="f1a"} | json
  {app="f1a", foo="l"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
# The literal key wins when it comes first.
eval select from 0 to 30s forward {app="f1b"} | json
  {app="f1b", foo="l"} `{"foo_extracted":"lit","foo":"p"}` @ 10s [parsed foo_extracted="lit"]
# A filter after the parser must see the final value too. A parser may stop on a line early, when a
# value that it just wrote fails a later filter (#24565). That check must not use the renamed value
# `p`, which the literal key replaces. Otherwise the parser drops the line with the renamed key
# first, before it reads the literal key. The queries below must agree with the `| json` queries
# above. This filter keeps both lines.
eval select from 0 to 30s forward {app=~"f1[ab]"} | json | foo_extracted="lit"
  {app="f1a", foo="l"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
  {app="f1b", foo="l"} `{"foo_extracted":"lit","foo":"p"}` @ 10s [parsed foo_extracted="lit"]
# The renamed value `p` does not exist in the result, so no line passes.
eval select from 0 to 30s forward {app=~"f1[ab]"} | json | foo_extracted="p"
  expect empty
# The same filter in a metric query.
eval instant at 60s sum by (foo_extracted) (count_over_time({app=~"f1[ab]"} | json | foo_extracted="lit" [1m]))
  {foo_extracted="lit"} 2
# The grouped form without a filter reads the same value. The grouping makes the parser extract only
# `foo` and `foo_extracted`.
eval instant at 60s sum by (foo_extracted) (count_over_time({app=~"f1[ab]"} | json [1m]))
  {foo_extracted="lit"} 2
eval range from 40s to 60s step 20s sum by (foo_extracted) (count_over_time({app=~"f1[ab]"} | json [1m])) # overlapping
  {foo_extracted="lit"} 2 2
# The expression form names the keys, and the order does not matter there either.
eval select from 0 to 30s forward {app=~"f1[ab]"} | json foo, foo_extracted
  {app="f1a", foo="l"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
  {app="f1b", foo="l"} `{"foo_extracted":"lit","foo":"p"}` @ 10s [parsed foo_extracted="lit"]

# A stream label or a structured metadata key that is called `foo_extracted` keeps the name. A
# parsed `foo` would move to `foo_extracted`, finds the name taken, and is dropped. A parsed
# `foo_extracted` finds the name taken too, so it takes a second suffix.
clear
load
  {app="f3", foo="l", foo_extracted="le"} `{"foo":"p"}`           @ 10s                           # stream labels `foo` and `foo_extracted`, and a parsed `foo`
  {app="f4", foo_extracted="le"}          `{"foo_extracted":"p"}` @ 10s                           # stream label `foo_extracted`, and a parsed `foo_extracted`
  {app="f5"}                              `{"foo_extracted":"p"}` @ 10s [metadata foo_extracted="me"] # metadata `foo_extracted`, and a parsed `foo_extracted`
  {app="noise", foo="l"}                  `{"foo":"noise"}`       @ 10s

# The parsed `foo` is dropped. The parsed `foo_extracted` becomes `foo_extracted_extracted`.
eval select from 0 to 30s forward {app=~"f[345]"} | json
  {app="f3", foo="l", foo_extracted="le"} `{"foo":"p"}` @ 10s
  {app="f4", foo_extracted="le"} `{"foo_extracted":"p"}` @ 10s [parsed foo_extracted_extracted="p"]
  {app="f5"} `{"foo_extracted":"p"}` @ 10s [metadata foo_extracted="me"] [parsed foo_extracted_extracted="p"]

# The stream has `foo` and `foo_extracted`, and the line has both keys. The renamed `foo` finds
# `foo_extracted` taken by the stream label, and is dropped. The literal key takes a second suffix.
clear
load
  {app="f7", foo="l", foo_extracted="le"} `{"foo":"p","foo_extracted":"q"}` @ 10s # both stream labels, and both keys in the line
  {app="noise", foo="l"}                  `{"foo":"noise"}`                 @ 10s

# The parsed `foo` is dropped, and the literal key becomes `foo_extracted_extracted`.
eval select from 0 to 30s forward {app="f7"} | json
  {app="f7", foo="l", foo_extracted="le"} `{"foo":"p","foo_extracted":"q"}` @ 10s [parsed foo_extracted_extracted="q"]

# The stream has `foo` and `foo_extracted`, and the metadata has `foo_extracted`. The metadata key
# finds the name taken when it enters the pipeline, so it takes a second suffix. The parsed `foo`
# finds `foo_extracted` taken by the stream label, and is dropped.
clear
load
  {app="f8", foo="l", foo_extracted="le"} `{"foo":"p"}`     @ 10s [metadata foo_extracted="me"] # both stream labels, and the same name in the metadata
  {app="noise", foo="l"}                  `{"foo":"noise"}` @ 10s

# The metadata key becomes `foo_extracted_extracted`, and the parsed `foo` is dropped.
eval select from 0 to 30s forward {app="f8"} | json
  {app="f8", foo="l", foo_extracted="le"} `{"foo":"p"}` @ 10s [metadata foo_extracted_extracted="me"]

# The expression form of logfmt names the keys: `logfmt foo, foo_extracted, bar`. A renamed key
# whose final name is also a name of the expression must not stop the parser, because the key after
# the pair is still needed. The empty label that stands for a missing key must not take the place of
# the renamed value. A grouping on every name must read every name.
clear
load
  {app="f9a", foo="l"}   "foo=p foo_extracted=lit bar=b" @ 10s # the renamed key comes first
  {app="f9b", foo="l"}   "foo_extracted=lit foo=p bar=b" @ 10s # the literal key comes first
  {app="f9c", foo="l"}   "foo=p bar=b"                   @ 10s # no literal key
  {app="f9d"}            "a=1 b=2"                       @ 10s # no clash, two names
  {app="noise", foo="l"} "foo=x bar=y"                   @ 10s

# The parser reads `bar` after the pair, in both key orders. The literal key wins. Without a literal
# key, the renamed value stays, and no empty label takes its place.
eval select from 0 to 30s forward {app=~"f9[abc]"} | logfmt foo, foo_extracted, bar
  {app="f9a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="f9b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="f9c", foo="l"} "foo=p bar=b" @ 10s [parsed bar="b" foo_extracted="p"]
# A grouping on `foo_extracted` and `bar` reads both names.
eval instant at 60s sum by (foo_extracted, bar) (count_over_time({app=~"f9[abc]"} | logfmt foo, foo_extracted, bar [1m]))
  {foo_extracted="lit", bar="b"} 2
  {foo_extracted="p", bar="b"} 1
eval range from 40s to 60s step 20s sum by (foo_extracted, bar) (count_over_time({app=~"f9[abc]"} | logfmt foo, foo_extracted, bar [1m])) # overlapping
  {foo_extracted="lit", bar="b"} 2 2
  {foo_extracted="p", bar="b"} 1 1
# A grouping on every name reads every name, also when nothing clashes.
eval instant at 60s sum by (a, b) (count_over_time({app="f9d"} | logfmt a, b [1m]))
  {a="1", b="2"} 1
eval range from 40s to 60s step 20s sum by (a, b) (count_over_time({app="f9d"} | logfmt a, b [1m])) # overlapping
  {a="1", b="2"} 1 1

# A duplicate key in one line, in the expression forms. The first value wins.
clear
load
  {app="h3"}    "foo=a foo=b"           @ 10s # the expression form `logfmt foo`
  {app="h4"}    `{"foo":"a","foo":"b"}` @ 10s # the expression form `json foo`
  {app="noise"} `{"foo":"x"}`           @ 10s

# The expression form of logfmt keeps the first value.
eval select from 0 to 30s forward {app="h3"} | logfmt foo
  {app="h3"} "foo=a foo=b" @ 10s [parsed foo="a"]
# The expression form of JSON keeps the first value.
eval select from 0 to 30s forward {app="h4"} | json foo
  {app="h4"} `{"foo":"a","foo":"b"}` @ 10s [parsed foo="a"]
