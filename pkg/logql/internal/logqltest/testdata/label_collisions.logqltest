# Label collisions: what happens when a name comes from more than one of the stream labels, the
# structured metadata, and the parsed fields. This file is the matrix of the cases. Each tag, such
# as `D2` or `F7`, names one case, and the `load` line that carries it holds the data of that case.
# `label_collisions_parsers.logqltest` runs the cases for every parser.
#
# The rules that the cases show:
#
# 1. Labels arrive in this order: stream labels, structured metadata, parsed labels, one parser stage
#    after another. The precedence is the same order: stream > structured metadata > parsed. The
#    result has one label for each name.
# 2. The source with the highest precedence keeps the name. A loser is renamed to `<name>_extracted`.
# 3. A label that has a name keeps it. A key is renamed at most once. If a stream label or a
#    structured metadata value already has the new name, the loser is dropped. A parsed key never
#    replaces a label. A key that is called `foo_extracted` in the line becomes
#    `foo_extracted_extracted` when a label has the name `foo_extracted`.
# 4. Among parsed keys the first writer wins, in every parser: of two equal keys in one line, and
#    between stages. In one stage, a literal `foo_extracted` key beats a renamed `foo` key.
# 5. In json, a null and an array give no label. In logfmt, an empty value gives no label, unless
#    `--keep-empty` is set. An empty JSON string is a real value.
# 6. An expression form (`json a`, `logfmt a`) asks for names. A name that the line lacks, or a JSON
#    null, gives an empty label. A name that a label already has gets no empty label.
# 7. `drop` before the parser removes a name from the clash test. `label_format` replaces any label.
#    A filter or a grouping does not change the labels of a line.
#
# - A: structured metadata and a stream label.
# - B: a parsed field and a stream label.
# - C: a parsed field and structured metadata.
# - D: all three.
# - E: two parsers in a row.
# - F: a literal `<name>_extracted` key.
# - G: the shape of a value.
# - H: a duplicate key in one line.
#
# Each section loads several streams and reads them with one query. One query then reads lines with
# a collision and lines without one, and each line resolves on its own. A log-selection query keeps
# the stream labels, the structured metadata, and the parsed labels apart, so each expected line
# states the category of every label. Sections B, D and E also have metric queries over the same
# lines. They take another path: the parser hints of a grouping decide which keys the parser
# extracts.
#

# A. A metadata key that clashes with a stream label moves to `<name>_extracted`, and stays in the
# metadata category (A1). The other lines keep their names.
clear
load
  {app="a1", foo="l"}    "A1" @ 10s [metadata foo="m"] # A1: stream label and metadata
  {app="a2"}             "A2" @ 10s [metadata foo="m"] # A2: metadata only
  {app="a3", foo="l"}    "A3" @ 10s                    # A3: stream label only
  {app="a4"}             "A4" @ 10s                    # A4: neither
  {app="noise", foo="l"} "x"  @ 10s [metadata foo="m"]

eval select from 0 to 30s forward {app=~"a[1-4]"}
  {app="a1", foo="l"} "A1" @ 10s [metadata foo_extracted="m"]
  {app="a2"} "A2" @ 10s [metadata foo="m"]
  {app="a3", foo="l"} "A3" @ 10s
  {app="a4"} "A4" @ 10s

# B. A parsed field and a stream label. The parsed field moves to `<name>_extracted` on the lines
# that have the stream label (B1) and keeps its name on the others (B2).
clear
load
  {app="b1", foo="l"}    `{"foo":"p"}`     @ 10s # B1: stream label and parsed field
  {app="b2"}             `{"foo":"p"}`     @ 10s # B2: parsed field only
  {app="b3", foo="l"}    `{"other":"x"}`   @ 10s # B3: stream label, and the line has no `foo`
  {app="b4"}             `{}`              @ 10s # B4: neither
  {app="noise", foo="l"} `{"foo":"noise"}` @ 10s

eval select from 0 to 30s forward {app=~"b[1-4]"} | json
  {app="b1", foo="l"} `{"foo":"p"}` @ 10s [parsed foo_extracted="p"]
  {app="b2"} `{"foo":"p"}` @ 10s [parsed foo="p"]
  {app="b3", foo="l"} `{"other":"x"}` @ 10s [parsed other="x"]
  {app="b4"} `{}` @ 10s
# A metric query merges the categories into one label set. The grouped form lets the parser extract
# only `foo`, so it takes the hint path.
eval instant at 60s count_over_time({app=~"b[1-4]"} | json [1m])
  {app="b1", foo="l", foo_extracted="p"} 1
  {app="b2", foo="p"} 1
  {app="b3", foo="l", other="x"} 1
  {app="b4"} 1
eval range from 40s to 60s step 20s count_over_time({app=~"b[1-4]"} | json [1m]) # overlapping
  {app="b1", foo="l", foo_extracted="p"} 1 1
  {app="b2", foo="p"} 1 1
  {app="b3", foo="l", other="x"} 1 1
  {app="b4"} 1 1
eval instant at 60s sum by (foo, foo_extracted) (count_over_time({app=~"b[1-4]"} | json [1m]))
  {foo="l", foo_extracted="p"} 1
  {foo="p"} 1
  {foo="l"} 1
  {} 1
eval range from 40s to 60s step 20s sum by (foo, foo_extracted) (count_over_time({app=~"b[1-4]"} | json [1m])) # overlapping
  {foo="l", foo_extracted="p"} 1 1
  {foo="p"} 1 1
  {foo="l"} 1 1
  {} 1 1

# C. A parsed field and structured metadata. The parsed field moves to `<name>_extracted` (C1). A
# line with the stream label instead of the metadata resolves the same way (C3).
clear
load
  {app="c1"}          `{"foo":"p"}`     @ 10s [metadata foo="m"] # C1: metadata and parsed field
  {app="c2"}          `{"other":"x"}`   @ 10s [metadata foo="m"] # C2: metadata, and the line has no `foo`
  {app="c3", foo="l"} `{"foo":"p"}`     @ 10s                    # C3: stream label and parsed field
  {app="noise"}       `{"foo":"noise"}` @ 10s [metadata foo="m"]

eval select from 0 to 30s forward {app=~"c[1-3]"} | json
  {app="c1"} `{"foo":"p"}` @ 10s [metadata foo="m"] [parsed foo_extracted="p"]
  {app="c2"} `{"other":"x"}` @ 10s [metadata foo="m"] [parsed other="x"]
  {app="c3", foo="l"} `{"foo":"p"}` @ 10s [parsed foo_extracted="p"]

# D. The stream label, the structured metadata, and the parsed field all have the name `foo`.
# The metadata key is renamed to `foo_extracted` when it enters the pipeline (A1). The parsed `foo` is
# renamed to `foo_extracted` too, and it finds the name taken, so the parsed value is dropped (D1).
# The metadata value stays when the line has no `foo` (D2). A metadata key that is already called
# `foo_extracted` keeps its name in the same way (D3). Without the stream label, the metadata keeps
# `foo` (D4). A `drop` before the parser frees a name in the three-way clash (D5): `drop foo` gives
# the base name to the parsed value, and `drop foo_extracted` gives `foo_extracted` to it. Naming the
# label in the parser (`json p="foo"`) avoids the clash. A `drop` after the parser is too late.
clear
load
  {app="d1", foo="l"}    `{"foo":"p","other":"x"}` @ 10s [metadata foo="m1"]           # D1
  {app="d2", foo="l"}    `{"other":"x"}`           @ 10s [metadata foo="m"]            # D2
  {app="d3", foo="l"}    `{"foo":"p"}`             @ 10s [metadata foo_extracted="me"] # D3
  {app="d4"}             `{"foo":"p","other":"x"}` @ 10s [metadata foo="m"]            # D4
  {app="d5", foo="l"}    `{"foo":"p"}`             @ 10s [metadata foo="m"]            # D5
  {app="noise", foo="l"} `{"foo":"noise"}`         @ 10s [metadata foo="m"]

eval select from 0 to 30s forward {app=~"d[1-4]"} | json
  {app="d1", foo="l"} `{"foo":"p","other":"x"}` @ 10s [metadata foo_extracted="m1"] [parsed other="x"]
  {app="d2", foo="l"} `{"other":"x"}` @ 10s [metadata foo_extracted="m"] [parsed other="x"]
  {app="d3", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="me"]
  {app="d4"} `{"foo":"p","other":"x"}` @ 10s [metadata foo="m"] [parsed foo_extracted="p" other="x"]
# The parsed value of `d1` is lost. The metadata values of `d1`, `d2` and `d3` stay.
eval instant at 60s count_over_time({app=~"d[1-4]"} | json [1m])
  {app="d1", foo="l", foo_extracted="m1", other="x"} 1
  {app="d2", foo="l", foo_extracted="m", other="x"} 1
  {app="d3", foo="l", foo_extracted="me"} 1
  {app="d4", foo="m", foo_extracted="p", other="x"} 1
eval instant at 60s sum by (foo, foo_extracted) (count_over_time({app=~"d[1-4]"} | json [1m]))
  {foo="l", foo_extracted="m1"} 1
  {foo="l", foo_extracted="m"} 1
  {foo="l", foo_extracted="me"} 1
  {foo="m", foo_extracted="p"} 1
eval range from 40s to 60s step 20s sum by (foo, foo_extracted) (count_over_time({app=~"d[1-4]"} | json [1m])) # overlapping
  {foo="l", foo_extracted="m1"} 1 1
  {foo="l", foo_extracted="m"} 1 1
  {foo="l", foo_extracted="me"} 1 1
  {foo="m", foo_extracted="p"} 1 1
# D5. The three-way clash gives the parsed value up. The ways around it:
eval select from 0 to 30s forward {app="d5"} | json
  {app="d5", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"]
eval select from 0 to 30s forward {app="d5"} | drop foo | json
  {app="d5"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"] [parsed foo="p"]
eval select from 0 to 30s forward {app="d5"} | drop foo_extracted | json
  {app="d5", foo="l"} `{"foo":"p"}` @ 10s [parsed foo_extracted="p"]
eval select from 0 to 30s forward {app="d5"} | json p="foo"
  {app="d5", foo="l"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"] [parsed p="p"]
# A drop after the parser is too late: the parser has already dropped the parsed value.
eval select from 0 to 30s forward {app="d5"} | json | drop foo
  {app="d5"} `{"foo":"p"}` @ 10s [metadata foo_extracted="m"]

# E. Two parsers in a row. `line_format` swaps the line between the two stages. The first stage to
# write a name keeps it, and the second stage skips that name. The stages do not overwrite each
# other. The first stage gives `foo=j1`, and the second gives `foo=f2`. The same holds when the second
# stage is an expression form (E7, E8).
clear
load
  {app="e1", foo="l"}    `{"foo":"j1","next":"foo=f2"}`  @ 10s # E1: both stages write `foo`
  {app="e2", foo="l"}    `{"foo":"j1","next":"bar=b2"}`  @ 10s # E2: the second stage has no `foo`
  {app="e3"}             `{"foo":"j1","next":"foo=f2"}`  @ 10s # E3: no stream label
  {app="e4", foo="l"}    `{"bar":"j1","next":"foo=f2"}`  @ 10s # E4: the first stage has no `foo`
  {app="e5", foo="l"}    `{"foo":"","next":"foo=f2"}`    @ 10s # E5: an empty value counts as written
  {app="e6", foo="l"}    `{"foo":"","next":"bar=b2"}`    @ 10s # E6: an empty value, and no `foo` in the second stage
  {app="e7"}             `{"foo":"j1","next":"foo=f2"}`  @ 10s # E7: the second stage is `logfmt foo`
  {app="e8"}             `{"foo":"j1"}`                  @ 10s # E8: the second stage is `json foo`
  {app="noise", foo="l"} `{"foo":"noise","next":"foo=noise"}` @ 10s

eval select from 0 to 30s forward {app=~"e[1-6]"} | json | line_format "{{.next}}" | logfmt
  {app="e1", foo="l"} "foo=f2" @ 10s [parsed foo_extracted="j1" next="foo=f2"]
  {app="e2", foo="l"} "bar=b2" @ 10s [parsed bar="b2" foo_extracted="j1" next="bar=b2"]
  {app="e3"} "foo=f2" @ 10s [parsed foo="j1" next="foo=f2"]
  {app="e4", foo="l"} "foo=f2" @ 10s [parsed bar="j1" foo_extracted="f2" next="foo=f2"]
  {app="e5", foo="l"} "foo=f2" @ 10s [parsed foo_extracted="" next="foo=f2"]
  {app="e6", foo="l"} "bar=b2" @ 10s [parsed bar="b2" foo_extracted="" next="bar=b2"]
# The metric forms leave out the lines with an empty value (E5, E6).
eval instant at 60s sum by (foo, foo_extracted) (count_over_time({app=~"e[1-4]"} | json | line_format "{{.next}}" | logfmt [1m]))
  {foo="l", foo_extracted="j1"} 2
  {foo="j1"} 1
  {foo="l", foo_extracted="f2"} 1
eval range from 40s to 60s step 20s sum by (foo, foo_extracted) (count_over_time({app=~"e[1-4]"} | json | line_format "{{.next}}" | logfmt [1m])) # overlapping
  {foo="l", foo_extracted="j1"} 2 2
  {foo="j1"} 1 1
  {foo="l", foo_extracted="f2"} 1 1
# An expression form in the second stage does not overwrite the value of the first stage either.
eval select from 0 to 30s forward {app="e7"} | json | line_format "{{.next}}" | logfmt foo
  {app="e7"} "foo=f2" @ 10s [parsed foo="j1" next="foo=f2"]
eval select from 0 to 30s forward {app="e8"} | json | line_format "{\"foo\":\"j2\"}" | json foo
  {app="e8"} `{"foo":"j2"}` @ 10s [parsed foo="j1"]

# F1. A line has `foo` and a literal `foo_extracted`, and the stream has `foo`. Both keys target
# `foo_extracted`. The literal key wins, and the key order in the line does not matter. JSON does
# not define a key order.
clear
load
  {app="f1a", foo="l"}   `{"foo":"p","foo_extracted":"lit"}` @ 10s # F1a: the renamed key comes first
  {app="f1b", foo="l"}   `{"foo_extracted":"lit","foo":"p"}` @ 10s # F1b: the literal key comes first
  {app="noise", foo="l"} `{"foo":"noise"}`                   @ 10s

eval select from 0 to 30s forward {app="f1a"} | json
  {app="f1a", foo="l"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
eval select from 0 to 30s forward {app="f1b"} | json
  {app="f1b", foo="l"} `{"foo_extracted":"lit","foo":"p"}` @ 10s [parsed foo_extracted="lit"]
# A filter after the parser must see the final value too. A parser may stop on a line early, when a
# value that it just wrote fails a later filter (#24565). That check must not use the renamed value
# `p` that the literal key replaces, or it drops the line of F1a before the parser reads the
# literal key. The queries below must agree with `| json` above.
eval select from 0 to 30s forward {app=~"f1[ab]"} | json | foo_extracted="lit"
  {app="f1a", foo="l"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
  {app="f1b", foo="l"} `{"foo_extracted":"lit","foo":"p"}` @ 10s [parsed foo_extracted="lit"]
eval select from 0 to 30s forward {app=~"f1[ab]"} | json | foo_extracted="p"
  expect empty
eval instant at 60s sum by (foo_extracted) (count_over_time({app=~"f1[ab]"} | json | foo_extracted="lit" [1m]))
  {foo_extracted="lit"} 2
# The grouped form without a filter reads the same value. The grouping makes the parser extract only
# `foo` and `foo_extracted`.
eval instant at 60s sum by (foo_extracted) (count_over_time({app=~"f1[ab]"} | json [1m]))
  {foo_extracted="lit"} 2
eval range from 40s to 60s step 20s sum by (foo_extracted) (count_over_time({app=~"f1[ab]"} | json [1m])) # overlapping
  {foo_extracted="lit"} 2 2
# The expression form names the keys, and the order does not matter there either.
eval select from 0 to 30s forward {app=~"f1[ab]"} | json foo, foo_extracted
  {app="f1a", foo="l"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
  {app="f1b", foo="l"} `{"foo_extracted":"lit","foo":"p"}` @ 10s [parsed foo_extracted="lit"]

# F2. Without a stream label `foo`, nothing is renamed, so a literal `foo_extracted` key keeps its
# name (F2), also next to a `foo` key (F2b). A query that also reads a stream with the label `foo`
# gives the same result for the lines of the streams without it (F6).
clear
load
  {app="f2"}             `{"foo_extracted":"lit"}`           @ 10s # F2
  {app="f2b"}            `{"foo":"p","foo_extracted":"lit"}` @ 10s # F2b
  {app="f6", foo="l"}    `{"other":"x"}`                     @ 10s # F6: the stream with the label `foo`
  {app="noise", foo="l"} `{"foo":"noise"}`                   @ 10s

eval select from 0 to 30s forward {app=~"f2|f2b"} | json
  {app="f2"} `{"foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
  {app="f2b"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo="p" foo_extracted="lit"]
eval select from 0 to 30s forward {app=~"f2|f2b|f6"} | json
  {app="f2"} `{"foo_extracted":"lit"}` @ 10s [parsed foo_extracted="lit"]
  {app="f2b"} `{"foo":"p","foo_extracted":"lit"}` @ 10s [parsed foo="p" foo_extracted="lit"]
  {app="f6", foo="l"} `{"other":"x"}` @ 10s [parsed other="x"]

# F3 to F5. A stream label or structured metadata key that is called `foo_extracted` keeps the name.
# A parsed `foo` is renamed to it, and dropped (F3). A parsed `foo_extracted` finds the name
# taken, so it takes a second suffix (F4, F5).
clear
load
  {app="f3", foo="l", foo_extracted="le"} `{"foo":"p"}`           @ 10s                           # F3
  {app="f4", foo_extracted="le"}          `{"foo_extracted":"p"}` @ 10s                           # F4
  {app="f5"}                              `{"foo_extracted":"p"}` @ 10s [metadata foo_extracted="me"] # F5
  {app="noise", foo="l"}                  `{"foo":"noise"}`       @ 10s

eval select from 0 to 30s forward {app=~"f[345]"} | json
  {app="f3", foo="l", foo_extracted="le"} `{"foo":"p"}` @ 10s
  {app="f4", foo_extracted="le"} `{"foo_extracted":"p"}` @ 10s [parsed foo_extracted_extracted="p"]
  {app="f5"} `{"foo_extracted":"p"}` @ 10s [metadata foo_extracted="me"] [parsed foo_extracted_extracted="p"]

# F7. The stream has `foo` and `foo_extracted`, and the line has both keys. The renamed `foo` finds
# `foo_extracted` taken by the stream label, and is dropped. The literal key takes a second suffix.
clear
load
  {app="f7", foo="l", foo_extracted="le"} `{"foo":"p","foo_extracted":"q"}` @ 10s # F7
  {app="noise", foo="l"}                  `{"foo":"noise"}`                 @ 10s

eval select from 0 to 30s forward {app="f7"} | json
  {app="f7", foo="l", foo_extracted="le"} `{"foo":"p","foo_extracted":"q"}` @ 10s [parsed foo_extracted_extracted="q"]

# F8. The stream has `foo` and `foo_extracted`, and the metadata has `foo_extracted`. The metadata
# key finds the name taken when it enters the pipeline, so it takes a second suffix. The parsed
# `foo` finds `foo_extracted` taken by the stream label, and is dropped.
clear
load
  {app="f8", foo="l", foo_extracted="le"} `{"foo":"p"}`     @ 10s [metadata foo_extracted="me"] # F8
  {app="noise", foo="l"}                  `{"foo":"noise"}` @ 10s

eval select from 0 to 30s forward {app="f8"} | json
  {app="f8", foo="l", foo_extracted="le"} `{"foo":"p"}` @ 10s [metadata foo_extracted_extracted="me"]

# F9. The expression form of logfmt names the keys: `logfmt foo, foo_extracted, bar`. A renamed key
# whose final name is also a name of the expression must not stop the parser, because the key after
# the pair is still needed (F9a, F9b). The empty label that stands for a missing key must not take
# the place of the renamed value (F9c). A grouping on every name must read every name (F9d).
clear
load
  {app="f9a", foo="l"}   "foo=p foo_extracted=lit bar=b" @ 10s # F9a: the renamed key comes first
  {app="f9b", foo="l"}   "foo_extracted=lit foo=p bar=b" @ 10s # F9b: the literal key comes first
  {app="f9c", foo="l"}   "foo=p bar=b"                   @ 10s # F9c: no literal key
  {app="f9d"}            "a=1 b=2"                       @ 10s # F9d: no clash, two names
  {app="noise", foo="l"} "foo=x bar=y"                   @ 10s

eval select from 0 to 30s forward {app=~"f9[abc]"} | logfmt foo, foo_extracted, bar
  {app="f9a", foo="l"} "foo=p foo_extracted=lit bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="f9b", foo="l"} "foo_extracted=lit foo=p bar=b" @ 10s [parsed bar="b" foo_extracted="lit"]
  {app="f9c", foo="l"} "foo=p bar=b" @ 10s [parsed bar="b" foo_extracted="p"]
eval instant at 60s sum by (foo_extracted, bar) (count_over_time({app=~"f9[abc]"} | logfmt foo, foo_extracted, bar [1m]))
  {foo_extracted="lit", bar="b"} 2
  {foo_extracted="p", bar="b"} 1
eval range from 40s to 60s step 20s sum by (foo_extracted, bar) (count_over_time({app=~"f9[abc]"} | logfmt foo, foo_extracted, bar [1m])) # overlapping
  {foo_extracted="lit", bar="b"} 2 2
  {foo_extracted="p", bar="b"} 1 1
eval instant at 60s sum by (a, b) (count_over_time({app="f9d"} | logfmt a, b [1m]))
  {a="1", b="2"} 1
eval range from 40s to 60s step 20s sum by (a, b) (count_over_time({app="f9d"} | logfmt a, b [1m])) # overlapping
  {a="1", b="2"} 1 1

# G. The shape of a value. An empty JSON string is a real value, so it moves like any other (G1)
# and it keeps its name without a clash (G2). A JSON null is not extracted at all (G3). A logfmt key
# with no value is not extracted, unless `--keep-empty` is set (G4). A key that is not extracted does
# not count as written, so a later key with the same final name still writes it (G5). With
# `--keep-empty` the empty value is written first, and it stays.
clear
load
  {app="g1", foo="l"}    `{"foo":""}`   @ 10s # G1
  {app="g2"}             `{"foo":""}`   @ 10s # G2
  {app="g3", foo="l"}    `{"foo":null}` @ 10s # G3
  {app="g4", foo="l"}    "foo="         @ 10s # G4
  {app="g5", foo="l"}    "foo_extracted= foo=p" @ 10s # G5
  {app="noise", foo="l"} `{"foo":"x"}`  @ 10s

eval select from 0 to 30s forward {app=~"g[123]"} | json
  {app="g1", foo="l"} `{"foo":""}` @ 10s [parsed foo_extracted=""]
  {app="g2"} `{"foo":""}` @ 10s [parsed foo=""]
  {app="g3", foo="l"} `{"foo":null}` @ 10s
eval select from 0 to 30s forward {app="g4"} | logfmt
  {app="g4", foo="l"} "foo=" @ 10s
eval select from 0 to 30s forward {app="g4"} | logfmt --keep-empty
  {app="g4", foo="l"} "foo=" @ 10s [parsed foo_extracted=""]
eval select from 0 to 30s forward {app="g5"} | logfmt
  {app="g5", foo="l"} "foo_extracted= foo=p" @ 10s [parsed foo_extracted="p"]
eval select from 0 to 30s forward {app="g5"} | logfmt --keep-empty
  {app="g5", foo="l"} "foo_extracted= foo=p" @ 10s [parsed foo_extracted=""]

# H. A duplicate key in one line. The first value wins, for JSON (H1), for logfmt (H2), and for their
# expression forms (H3, H4).
clear
load
  {app="h1"}    `{"foo":"a","foo":"b"}` @ 10s # H1
  {app="h2"}    "foo=a foo=b"           @ 10s # H2
  {app="h3"}    "foo=a foo=b"           @ 10s # H3: `logfmt foo`
  {app="h4"}    `{"foo":"a","foo":"b"}` @ 10s # H4: `json foo`
  {app="noise"} `{"foo":"x"}`           @ 10s

eval select from 0 to 30s forward {app="h1"} | json
  {app="h1"} `{"foo":"a","foo":"b"}` @ 10s [parsed foo="a"]
eval select from 0 to 30s forward {app="h2"} | logfmt
  {app="h2"} "foo=a foo=b" @ 10s [parsed foo="a"]
eval select from 0 to 30s forward {app="h3"} | logfmt foo
  {app="h3"} "foo=a foo=b" @ 10s [parsed foo="a"]
eval select from 0 to 30s forward {app="h4"} | json foo
  {app="h4"} `{"foo":"a","foo":"b"}` @ 10s [parsed foo="a"]
