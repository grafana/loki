  {app="s", size="2TiB"} 2 4 4
  {app="s", size="2PB"} 2 4 4
  {app="s", size="2PiB"} 2 4 4
eval range from 60s to 180s step 120s count_over_time({app="s"} | size > 1MB [1m]) # non-overlapping
  {app="s", size="3MB"} 4 _
  {app="s", size="2MiB"} 4 _
