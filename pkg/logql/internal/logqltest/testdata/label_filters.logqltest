  {app="m", size="2PiB"} 3 5 5
eval range from 60s to 180s step 120s count_over_time({app="m"} | size > 1MB [1m]) # non-overlapping
  {app="m", size="3MB"} 5 _
  {app="m", size="2048KiB"} 5 _
