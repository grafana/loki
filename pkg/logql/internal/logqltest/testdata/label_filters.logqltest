  {app="s", size="500KB"} 2
  {app="s", size="500KiB"} 2
# structured metadata
eval instant at 60s count_over_time({app="m"} | size > 1MB [1m])
  {app="m", size="3MB"} 5
  {app="m", size="2048KiB"} 5
  {app="m", size="2MiB"} 5
  {app="m", size="2GB"} 5
