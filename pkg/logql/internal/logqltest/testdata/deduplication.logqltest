# Deduplicate same logs without structured metadata.
clear
load
  {app="a"}     "val=1" @ 30s
  {app="a"}     "val=3" @ 50s
  {app="noise"} "val=1" @ 30s

flush

load
  {app="a"} "val=1" @ 30s   # Duplicated
  {app="a"} "val=2" @ 40s

eval select from 0 to 60s forward {app="a"}
  {app="a"} "val=1" @ 30s
  {app="a"} "val=2" @ 40s
  {app="a"} "val=3" @ 50s
eval instant at 60s count_over_time({app="a"}[1m])
  {app="a"} 3
eval instant at 60s sum by (trace_id) (count_over_time({app="a"}[1m]))
  {} 3
eval instant at 60s count by (app) (count_over_time({app="a"}[1m]))
  {app="a"} 1
eval instant at 60s sum by (app) (count_over_time({app="a"}[1m]))
  {app="a"} 3
eval instant at 60s sum without (trace_id) (count_over_time({app="a"}[1m]))
  {app="a"} 3
eval instant at 60s sum(count_over_time({app="a"}[1m]))
  {} 3
eval instant at 60s sum by (app) (bytes_over_time({app="a"}[1m]))
  {app="a"} 15
eval instant at 60s sum by (app) (rate({app="a"}[1m]))
  {app="a"} 0.05
eval instant at 60s sum(max_over_time({app="a"} | logfmt | unwrap val [1m]))
  {} 3
eval instant at 60s sum(sum_over_time({app="a"} | logfmt | unwrap val [1m]))
  {} 6
eval range from 0 to 60s step 30s sum by (app) (count_over_time({app="a"}[1m]))  # overlapping
  {app="a"} _ 1 3

# Deduplicate same logs with structured metadata.
clear
load
  {app="a"}     "val=1" @ 30s [metadata trace_id="1"]
  {app="a"}     "val=3" @ 50s [metadata trace_id="1"]
  {app="noise"} "val=1" @ 30s [metadata trace_id="1"]

flush

load
  {app="a"} "val=1" @ 30s [metadata trace_id="1"]   # Duplicated
  {app="a"} "val=2" @ 40s [metadata trace_id="1"]

eval select from 0 to 60s forward {app="a"}
  {app="a"} "val=1" @ 30s [metadata trace_id="1"]
  {app="a"} "val=2" @ 40s [metadata trace_id="1"]
  {app="a"} "val=3" @ 50s [metadata trace_id="1"]
eval instant at 60s count_over_time({app="a"}[1m])
  {app="a", trace_id="1"} 3
eval instant at 60s sum by (trace_id) (count_over_time({app="a"}[1m]))
  {trace_id="1"} 3
eval instant at 60s count by (app) (count_over_time({app="a"}[1m]))
  {app="a"} 1
eval instant at 60s sum by (app) (count_over_time({app="a"}[1m]))
  {app="a"} 3
eval instant at 60s sum without (trace_id) (count_over_time({app="a"}[1m]))
  {app="a"} 3
eval instant at 60s sum(count_over_time({app="a"}[1m]))
  {} 3
eval instant at 60s sum by (app) (bytes_over_time({app="a"}[1m]))
  {app="a"} 15
eval instant at 60s sum by (app) (rate({app="a"}[1m]))
  {app="a"} 0.05
eval instant at 60s sum(max_over_time({app="a"} | logfmt | unwrap val [1m]))
  {} 3
eval instant at 60s sum(sum_over_time({app="a"} | logfmt | unwrap val [1m]))
  {} 6
eval range from 0 to 60s step 30s sum by (app) (count_over_time({app="a"}[1m]))  # overlapping
  {app="a"} _ 1 3

# Do not deduplicate log entries that differ only by structured metadata.
clear
load
  {app="a"}     "val=5" @ 30s [metadata trace_id="1"]
  {app="noise"} "val=5" @ 30s [metadata trace_id="1"]

flush

load
  {app="a"} "val=5" @ 30s [metadata trace_id="2"]

eval select from 0 to 60s forward {app="a"}
  {app="a"} "val=5" @ 30s [metadata trace_id="1"]
  {app="a"} "val=5" @ 30s [metadata trace_id="2"]
eval instant at 60s count_over_time({app="a"}[1m])
  {app="a", trace_id="1"} 1
  {app="a", trace_id="2"} 1
eval instant at 60s sum by (trace_id) (count_over_time({app="a"}[1m]))
  {trace_id="1"} 1
  {trace_id="2"} 1
eval instant at 60s count by (app) (count_over_time({app="a"}[1m]))
  {app="a"} 2
eval instant at 60s sum by (app) (count_over_time({app="a"}[1m]))
  {app="a"} 2
eval instant at 60s sum without (trace_id) (count_over_time({app="a"}[1m]))
  {app="a"} 2
eval instant at 60s sum(count_over_time({app="a"}[1m]))
  {} 2
eval instant at 60s sum by (app) (bytes_over_time({app="a"}[1m]))
  {app="a"} 10
eval instant at 60s sum by (app) (rate({app="a"}[1m]))
  {app="a"} 0.0333333333   # 2 / 60s
eval instant at 60s sum(max_over_time({app="a"} | logfmt | unwrap val [1m]))
  {} 10
eval instant at 60s sum(sum_over_time({app="a"} | logfmt | unwrap val [1m]))
  {} 10
eval range from 0 to 60s step 30s sum by (app) (count_over_time({app="a"}[1m]))  # overlapping
  {app="a"} _ 2 2

# Sum different values of log entries that differ only by structured metadata.
clear
load
  {app="a"}     "boom" @ 30s [metadata trace_id="1" val="5"]
  {app="noise"} "boom" @ 30s [metadata trace_id="1" val="5"]

flush

load
  {app="a"} "boom" @ 30s [metadata trace_id="2" val="9"]

eval select from 0 to 60s forward {app="a"}
  {app="a"} "boom" @ 30s [metadata trace_id="1" val="5"]
  {app="a"} "boom" @ 30s [metadata trace_id="2" val="9"]
eval instant at 60s sum_over_time({app="a"} | unwrap val [1m])
  {app="a", trace_id="1"} 5
  {app="a", trace_id="2"} 9
eval instant at 60s sum(max_over_time({app="a"} | unwrap val [1m]))
  {} 14
eval instant at 60s sum(sum_over_time({app="a"} | unwrap val [1m]))
  {} 14
eval range from 0 to 60s step 30s sum(sum_over_time({app="a"} | unwrap val [1m]))  # overlapping
  {} _ 14 14

# Deduplication gives the same answer whatever chunks hold the data.
clear
load
  {app="one-chunk"}  "boom" @ 30s [metadata trace_id="1"]
  {app="one-chunk"}  "boom" @ 30s [metadata trace_id="2"]
  {app="two-chunks"} "boom" @ 30s [metadata trace_id="1"]
  {app="noise"}      "boom" @ 30s [metadata trace_id="1"]

flush

load
  {app="two-chunks"} "boom" @ 30s [metadata trace_id="2"] # Different chunk

eval select from 0 to 60s forward {app=~"one-chunk|two-chunks"}
  {app="one-chunk"}  "boom" @ 30s [metadata trace_id="1"]
  {app="one-chunk"}  "boom" @ 30s [metadata trace_id="2"]
  {app="two-chunks"} "boom" @ 30s [metadata trace_id="1"]
  {app="two-chunks"} "boom" @ 30s [metadata trace_id="2"]
eval instant at 60s sum by (app) (count_over_time({app=~"one-chunk|two-chunks"}[1m]))
  {app="one-chunk"}  2
  {app="two-chunks"} 2
eval range from 0 to 60s step 30s sum by (app) (count_over_time({app=~"one-chunk|two-chunks"}[1m]))  # overlapping
  {app="one-chunk"}  _ 2 2
  {app="two-chunks"} _ 2 2
