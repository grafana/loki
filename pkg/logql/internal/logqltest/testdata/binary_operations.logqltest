# `or vector(0)` fills the steps where the left side is absent.
clear
load
  {app="foo"}   "x"     @ 0s [repeat every 10s for 7]
  {app="noise"} "noise" @ 0s [repeat every 10s for 19]

eval range from 60s to 180s step 30s rate({app="foo"}[1m]) or vector(0)
  {app="foo"} 0.1 0.05 _ _ _
  {} 0 0 0 0 0

eval range from 60s to 180s step 30s sum(rate({app="foo"}[1m])) or vector(0)
  {} 0.1 0.05 0 0 0

# Non-bool `>` drops the non-matching samples; `> bool` keeps values as 0.
clear
load
  {app="foo"}   "x"     @ 10s [repeat every 10s for 5]
  {app="foo"}   "x"     @ 100s
  {app="noise"} "noise" @ 10s [repeat every 10s for 6]

eval range from 60s to 120s step 30s count_over_time({app="foo"}[1m]) > 3
  {app="foo"} 5 _ _
eval range from 60s to 120s step 30s count_over_time({app="foo"}[1m]) > bool 3
  {app="foo"} 1 0 0
